name = "{{name}}"
main = "build/worker/shim.mjs"
compatibility_date = "2025-01-01"

[build]
command = "cargo install -q worker-build && worker-build --release"

[[durable_objects.bindings]]
name = "ROOM"
class_name = "{{Room}}Object"

# Optional room registry: powers `hearth-mp inspect rooms`. Rooms skip reporting when
# this binding is absent.
[[durable_objects.bindings]]
name = "HEARTH_REGISTRY"
class_name = "HearthRegistry"

[[migrations]]
tag = "v1"
new_sqlite_classes = ["{{Room}}Object"]

[[migrations]]
tag = "v2"
new_sqlite_classes = ["HearthRegistry"]

# Workers Logs: the runtime emits one JSON line per join, leave, dispose,
# handler error and incompatible-state wake.
[observability]
enabled = true

# Abuse limits. The per-IP limit is generous because many players can share one
# IP (CGNAT, schools); the per-player limit is the tight one. Without these
# bindings the gateway allows every request.
[[ratelimits]]
name = "HEARTH_IP_LIMIT"
namespace_id = "1001"
simple = { limit = 300, period = 60 }

[[ratelimits]]
name = "HEARTH_PLAYER_LIMIT"
namespace_id = "1002"
simple = { limit = 60, period = 60 }

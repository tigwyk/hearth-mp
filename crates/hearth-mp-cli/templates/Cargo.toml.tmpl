[package]
name = "{{crate_name}}"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
# worker-build requires cdylib; rlib keeps `cargo test` usable.
crate-type = ["cdylib", "rlib"]

[dependencies]
hearth-mp = "0.1"
hearth-mp-gateway = "0.1"
serde = { version = "1", features = ["derive"] }
worker = "0.8"

[dev-dependencies]
# Used by the test-only schema export that `hearth-mp codegen` runs.
serde_json = "1"

# Small Wasm bundles (docs/limits.md "Bundle size"). Keep unwinding: no
# `panic = "abort"`.
[profile.release]
opt-level = "z"
lto = true
codegen-units = 1
